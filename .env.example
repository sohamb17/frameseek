# Copy to .env (never commit .env). Everything here is optional.

# --- Conversational search: optional LLM intent parser (rule-based parser works with no key) ---
# GitHub Models is free with a GitHub account (rate-limited, not for production):
# create a fine-grained token with the "models:read" permission at https://github.com/settings/tokens
# FRAMESEEK_LLM_PROVIDER=openai_compatible
# FRAMESEEK_LLM_BASE_URL=https://models.github.ai/inference
# FRAMESEEK_LLM_MODEL=openai/gpt-4o-mini
# FRAMESEEK_LLM_API_KEY=github_pat_xxx
#
# Any OpenAI-compatible endpoint works the same way, e.g. local Ollama:
# FRAMESEEK_LLM_BASE_URL=http://host.docker.internal:11434/v1  FRAMESEEK_LLM_MODEL=llama3.2:3b  FRAMESEEK_LLM_API_KEY=ollama

# --- Secrets (change for any deployment that is not your own laptop) ---
# FRAMESEEK_INTERNAL_TOKEN=change-me
# FRAMESEEK_MEDIA_SECRET=change-me

# --- Auth: "none" = single demo owner. "token" = bearer tokens per owner ---
# FRAMESEEK_AUTH_MODE=token
# FRAMESEEK_TOKENS=demo:secret1,alice:secret2

# --- Worker tuning ---
# FRAMESEEK_LOW_MEMORY=true      # unload each model after its stage (recommended on 8 GB machines)
# FRAMESEEK_LEASE_SECONDS=45
